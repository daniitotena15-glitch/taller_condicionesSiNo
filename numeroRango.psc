Algoritmo numeroRango
	Definir num como real
	Escribir "Este programa calcula si el numero que se ingresa al programa cumple y se encuntra en el rango entre (3.5, 7.8]"
	escribir " "
	Escribir "Ingrese cualquier numero"
	Leer num
	si num >3.5 y num <=7.8 Entonces
		escribir "El numero se encuntra en el rango"
		escribir " "
	sino 
		escribir "lo siento no cumple el parametro"
		escribir " "
	FinSi
FinAlgoritmo
