Algoritmo opcionesCaracter
	Definir opci como caracter
	Escribir "Ingresar por favor ´A,a´ opcion es Android o ´I,i´ si tu opcion es iOS"
	Leer opci
	si opci == 'a' o opci == 'A' Entonces
		escribir "Tu respuesta Android"
	sino
		si opci == 'i' o opci == 'I' Entonces
			escribir "Tu respuesta iOS"
		SiNo
			escribir "Tu opcion es invalida"
		FinSi
	FinSi
FinAlgoritmo
