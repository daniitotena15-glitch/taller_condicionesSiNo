Algoritmo numImparPar
	Definir num como entero
	Escribir "Este programa calcula si un numero es par o impar "
	Escribir "Ingresa el primer numero"
	leer num
	si num mod 2 = 0 
		Escribir "El numero es par"
		Escribir ""
	sino 
		Escribir "El numero es impar"
		Escribir ""
	FinSi
	
FinAlgoritmo
